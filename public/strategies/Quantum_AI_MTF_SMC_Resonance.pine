//@version=5
strategy("Quantum AI Multi-Timeframe SMC & Resonance [MI-007]", overlay=true, margin_long=100, margin_short=100, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// QUANTUM AI MULTI-TIMEFRAME SMART MONEY CONCEPTS (SMC) & RESONANCE STRATEGY
// System: Market Intelligence MI-007 Flagship Institutional Model
// Features:
// - Non-repainting multi-timeframe synchronization (barmerge.lookahead_off)
// - Macro HTF trend hierarchy and 50% Equilibrium Dealing Range
// - Intermediate MTF Liquidity Sweeps (BSL/SSL) and Order Block / FVG detection
// - Lower LTF Micro-CHoCH/MSS, directional displacement & inducement traps
// - Mathematical 0 - 100% Resonance Confluence Scoring Engine (Threshold >= 75%)
// - Dynamic on-chart dashboard HUD & Strategy Tester backtest integration
// ═══════════════════════════════════════════════════════════════════════════════

// ── 1. Strategy Inputs & Configuration ─────────────────────────────────────────

grp_mtf   = "=== Multi-Timeframe Architecture ==="
htf_res   = input.timeframe("D", "Higher Timeframe (HTF - Macro Dealing Range)", group=grp_mtf)
mtf_res   = input.timeframe("60", "Intermediate Timeframe (MTF - Structure & Sweeps)", group=grp_mtf)

grp_res   = "=== Resonance & Confluence Engine ==="
min_score = input.int(75, "Minimum Resonance Score for Entry (0-100)", minval=50, maxval=95, group=grp_res)
pvt_len   = input.int(5, "Swing Detection Pivot Lookback", minval=2, maxval=20, group=grp_res)
fvg_mult  = input.float(0.5, "FVG Minimum ATR Threshold Multiplier", minval=0.1, maxval=2.0, step=0.1, group=grp_res)

grp_exec  = "=== Risk & Trade Execution Management ==="
risk_per_trade = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_exec)
tp1_rr    = input.float(2.0, "Take-Profit 1 (Internal Liquidity R:R)", minval=1.0, maxval=5.0, step=0.5, group=grp_exec)
tp2_rr    = input.float(3.5, "Take-Profit 2 (External Liquidity R:R)", minval=2.0, maxval=10.0, step=0.5, group=grp_exec)

grp_vis   = "=== Chart Visuals & HUD Dashboard ==="
show_hud   = input.bool(true, "Show On-Chart Resonance HUD Dashboard", group=grp_vis)
show_boxes = input.bool(true, "Draw Order Blocks & Fair Value Gaps", group=grp_vis)
show_swings= input.bool(true, "Draw Swing Structure & BOS/CHoCH Lines", group=grp_vis)

// ── 2. Multi-Timeframe Macro Data Ingestion (Strict Zero Look-Ahead) ──────────

// Ingest closed candle HTF data to guarantee non-repainting historical consistency
htf_close = request.security(syminfo.tickerid, htf_res, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_high  = request.security(syminfo.tickerid, htf_res, high[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_low   = request.security(syminfo.tickerid, htf_res, low[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_sma50 = request.security(syminfo.tickerid, htf_res, ta.sma(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_off)

// Macro HTF Trend & Dealing Range (50% Equilibrium)
htf_bullish = htf_close > htf_sma50
htf_bearish = htf_close < htf_sma50

htf_range_high = request.security(syminfo.tickerid, htf_res, ta.highest(high, 40)[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_range_low  = request.security(syminfo.tickerid, htf_res, ta.lowest(low, 40)[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_eq         = (htf_range_high + htf_range_low) / 2.0

in_discount = close < htf_eq
in_premium  = close > htf_eq

// ── 3. Market Structure & Pivot Detection (Zero Look-Ahead) ───────────────────

ph = ta.pivothigh(high, pvt_len, pvt_len)
pl = ta.pivotlow(low, pvt_len, pvt_len)

var float last_sh = na
var float last_sl = na
var int last_sh_bar = na
var int last_sl_bar = na

if not na(ph)
    last_sh := ph
    last_sh_bar := bar_index - pvt_len

if not na(pl)
    last_sl := pl
    last_sl_bar := bar_index - pvt_len

// ── 4. Liquidity Sweeps (BSL / SSL) ───────────────────────────────────────────

// Sell-Side Liquidity (SSL) Sweep: Price pierces below prior swing low but closes back above it
ssl_sweep = not na(last_sl) and low < last_sl and close > last_sl and (close - low) > (high - low) * 0.35

// Buy-Side Liquidity (BSL) Sweep: Price pierces above prior swing high but closes back below it
bsl_sweep = not na(last_sh) and high > last_sh and close < last_sh and (high - close) > (high - low) * 0.35

// ── 5. Structure Break Detection (BOS & CHoCH) ────────────────────────────────

bull_bos = not na(last_sh) and ta.crossover(close, last_sh) and htf_bullish
bear_bos = not na(last_sl) and ta.crossunder(close, last_sl) and htf_bearish

bull_choch = not na(last_sh) and ta.crossover(close, last_sh) and htf_bearish
bear_choch = not na(last_sl) and ta.crossunder(close, last_sl) and htf_bullish

// ── 6. Fair Value Gaps (FVG) & Order Blocks ───────────────────────────────────

atr_val = ta.atr(14)
bull_fvg = (low > high[2]) and (low - high[2]) > (atr_val * fvg_mult)
bear_fvg = (high < low[2]) and (low[2] - high) > (atr_val * fvg_mult)

// Order Block (last opposing candle before structural displacement)
bull_ob = bull_bos and close[1] < open[1]
bear_ob = bear_bos and close[1] > open[1]

// ── 7. Directional Displacement & Volume Confirmation ─────────────────────────

body_size = math.abs(close - open)
is_displacement = body_size > (atr_val * 1.3)
vol_ma = ta.sma(volume, 20)
is_volume_confirmed = volume > (vol_ma * 1.3)

// ── 8. Mathematical Resonance Confluence Scoring Engine (0 - 100%) ───────────

var int bull_resonance = 0
var int bear_resonance = 0

bull_resonance := 0
bear_resonance := 0

// Factor 1: HTF Trend & Dealing Range Alignment (Max 20 pts)
if htf_bullish and in_discount
    bull_resonance += 20
else if htf_bullish
    bull_resonance += 12
else if in_discount
    bull_resonance += 14

if htf_bearish and in_premium
    bear_resonance += 20
else if htf_bearish
    bear_resonance += 12
else if in_premium
    bear_resonance += 14

// Factor 2: Verified Liquidity Sweep (Max 20 pts)
if ssl_sweep
    bull_resonance += 20
if bsl_sweep
    bear_resonance += 20

// Factor 3: Structural Confirmation BOS/CHoCH (Max 15 pts)
if bull_bos or bull_choch
    bull_resonance += 15
if bear_bos or bear_choch
    bear_resonance += 15

// Factor 4: Order Block & FVG Golden Zone (Max 15 pts)
if bull_fvg or bull_ob
    bull_resonance += 15
if bear_fvg or bear_ob
    bear_resonance += 15

// Factor 5: LTF Displacement (Max 15 pts)
if is_displacement and close > open
    bull_resonance += 15
else if is_displacement and close < open
    bear_resonance += 15
else
    bull_resonance += 5
    bear_resonance += 5

// Factor 6: Volume Surge / Aggression (Max 15 pts)
if is_volume_confirmed and close > open
    bull_resonance += 15
else if is_volume_confirmed and close < open
    bear_resonance += 15
else
    bull_resonance += 5
    bear_resonance += 5

// ── 9. Setup Execution Triggers & Orders ──────────────────────────────────────

long_setup_active  = bull_resonance >= min_score and (ssl_sweep or bull_bos or bull_choch or bull_fvg)
short_setup_active = bear_resonance >= min_score and (bsl_sweep or bear_bos or bear_choch or bear_fvg)

var float long_entry_price = na
var float long_sl_price    = na
var float long_tp1_price   = na
var float long_tp2_price   = na

var float short_entry_price = na
var float short_sl_price    = na
var float short_tp1_price   = na
var float short_tp2_price   = na

if long_setup_active and strategy.position_size == 0
    long_entry_price := close
    long_sl_price    := math.min(not na(last_sl) ? last_sl : low, low) * 0.996
    risk             = long_entry_price - long_sl_price
    long_tp1_price   := long_entry_price + (risk * tp1_rr)
    long_tp2_price   := math.max(not na(htf_range_high) ? htf_range_high : long_entry_price + (risk * tp2_rr), long_entry_price + (risk * tp2_rr))
    strategy.entry("Long Resonance", strategy.long, comment="Quantum AI Long (" + str.tostring(bull_resonance) + "%)")
    strategy.exit("Exit Long", "Long Resonance", stop=long_sl_price, limit=long_tp2_price)

if short_setup_active and strategy.position_size == 0
    short_entry_price := close
    short_sl_price    := math.max(not na(last_sh) ? last_sh : high, high) * 1.004
    risk              = short_sl_price - short_entry_price
    short_tp1_price   := short_entry_price - (risk * tp1_rr)
    short_tp2_price   := math.min(not na(htf_range_low) ? htf_range_low : short_entry_price - (risk * tp2_rr), short_entry_price - (risk * tp2_rr))
    strategy.entry("Short Resonance", strategy.short, comment="Quantum AI Short (" + str.tostring(bear_resonance) + "%)")
    strategy.exit("Exit Short", "Short Resonance", stop=short_sl_price, limit=short_tp2_price)

// ── 10. Chart Visuals & Annotations ──────────────────────────────────────────

plotshape(ssl_sweep, title="SSL Sweep", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="SSL Sweep")
plotshape(bsl_sweep, title="BSL Sweep", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="BSL Sweep")

plotshape(bull_bos, title="Bullish BOS", location=location.belowbar, color=color.teal, style=shape.labelup, size=size.tiny, text="BOS ↑")
plotshape(bear_bos, title="Bearish BOS", location=location.abovebar, color=color.maroon, style=shape.labeldown, size=size.tiny, text="BOS ↓")

plotshape(bull_choch, title="Bullish CHoCH", location=location.belowbar, color=color.emerald, style=shape.labelup, size=size.tiny, text="CHoCH ↑")
plotshape(bear_choch, title="Bearish CHoCH", location=location.abovebar, color=color.fuchsia, style=shape.labeldown, size=size.tiny, text="CHoCH ↓")

// Fair Value Gap Boxes
if show_boxes and bull_fvg
    box.new(left=bar_index-2, top=low, right=bar_index, bottom=high[2], border_color=color.new(color.green, 60), bgcolor=color.new(color.green, 85))

if show_boxes and bear_fvg
    box.new(left=bar_index-2, top=low[2], right=bar_index, bottom=high, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85))

// ── 11. On-Chart Real-Time Resonance HUD Dashboard ───────────────────────────

var table hud = table.new(position.top_right, 2, 7, bgcolor=color.new(#0f172a, 10), border_color=#334155, border_width=1)

if show_hud and barstate.islast
    table.cell(hud, 0, 0, "QUANTUM AI SMC HUD", bgcolor=#1e293b, text_color=#38bdf8, text_size=size.small)
    table.cell(hud, 1, 0, "STATUS", bgcolor=#1e293b, text_color=#38bdf8, text_size=size.small)

    table.cell(hud, 0, 1, "HTF Macro Trend", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 1, htf_bullish ? "BULLISH" : "BEARISH", bgcolor=htf_bullish ? #065f46 : #7f1d1d, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 2, "Dealing Range", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 2, in_discount ? "DISCOUNT (<50%)" : "PREMIUM (>50%)", bgcolor=in_discount ? #064e3b : #831843, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 3, "Resonance Bull Score", text_color=#94a3b8, text_size=size.small)
    color bull_col = bull_resonance >= 75 ? #10b981 : bull_resonance >= 50 ? #f59e0b : #64748b
    table.cell(hud, 1, 3, str.tostring(bull_resonance) + " %", bgcolor=bull_col, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 4, "Resonance Bear Score", text_color=#94a3b8, text_size=size.small)
    color bear_col = bear_resonance >= 75 ? #ef4444 : bear_resonance >= 50 ? #f59e0b : #64748b
    table.cell(hud, 1, 4, str.tostring(bear_resonance) + " %", bgcolor=bear_col, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 5, "Active Institutional Setup", text_color=#94a3b8, text_size=size.small)
    string setup_str = long_setup_active ? "BULLISH ENTRY" : short_setup_active ? "BEARISH ENTRY" : "WATCHING"
    color setup_col  = long_setup_active ? #047857 : short_setup_active ? #b91c1c : #334155
    table.cell(hud, 1, 5, setup_str, bgcolor=setup_col, text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 6, "Execution Signal", text_color=#94a3b8, text_size=size.small)
    table.cell(hud, 1, 6, strategy.position_size != 0 ? (strategy.position_size > 0 ? "IN LONG" : "IN SHORT") : "FLAT", bgcolor=#0f172a, text_color=#38bdf8, text_size=size.small)

// ── 12. TradingView Alert Conditions ──────────────────────────────────────────

alertcondition(long_setup_active, title="Quantum AI Long Setup", message="Quantum AI SMC Long: {{ticker}} @ {{close}} | Stop: Structural Invalidation | Target: BSL External Liquidity")
alertcondition(short_setup_active, title="Quantum AI Short Setup", message="Quantum AI SMC Short: {{ticker}} @ {{close}} | Stop: Structural Invalidation | Target: SSL External Liquidity")
alertcondition(ssl_sweep, title="SSL Liquidity Sweep Alert", message="Quantum AI Alert: SSL Liquidity Sweep on {{ticker}} @ {{close}}")
alertcondition(bsl_sweep, title="BSL Liquidity Sweep Alert", message="Quantum AI Alert: BSL Liquidity Sweep on {{ticker}} @ {{close}}")
