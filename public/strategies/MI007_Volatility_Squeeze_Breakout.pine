//@version=5
strategy("MI-007 Volatility Squeeze & Liquidity Breakout", overlay=true, margin_long=100, margin_short=100, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ═══════════════════════════════════════════════════════════════════════════════
// MI-007 VOLATILITY SQUEEZE & LIQUIDITY BREAKOUT
// System: Market Intelligence MI-007 Proprietary Quantitative Model
// Rules:
// - Bollinger Bands (20, 2.0) compress inside Keltner Channels (20, 1.5)
// - Squeeze fires when Bollinger Bands expand beyond Keltner Channels
// - Direction confirmed via Momentum Histogram & Volume Expansion
// ═══════════════════════════════════════════════════════════════════════════════

bb_len   = input.int(20, "Bollinger Period")
bb_mult  = input.float(2.0, "Bollinger StdDev Multiplier")
kc_len   = input.int(20, "Keltner Period")
kc_mult  = input.float(1.5, "Keltner ATR Multiplier")
tp_rr    = input.float(3.0, "Take-Profit R:R Ratio")

// Bollinger Bands
bb_basis = ta.sma(close, bb_len)
bb_dev   = bb_mult * ta.stdev(close, bb_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

// Keltner Channels
kc_ma    = ta.ema(close, kc_len)
kc_range = ta.atr(kc_len) * kc_mult
kc_upper = kc_ma + kc_range
kc_lower = kc_ma - kc_range

// Squeeze condition (BB inside KC)
squeeze_on  = (bb_lower > kc_lower) and (bb_upper < kc_upper)
squeeze_off = (bb_lower < kc_lower) and (bb_upper > kc_upper)
squeeze_fired = squeeze_on[1] and squeeze_off

// Momentum
mom = ta.linreg(close - math.avg(math.avg(ta.highest(high, kc_len), ta.lowest(low, kc_len)), ta.sma(close, kc_len)), kc_len, 0)
vol_surge = volume > ta.sma(volume, 20) * 1.3

long_signal  = (squeeze_fired or squeeze_off) and ta.crossover(mom, 0) and vol_surge and close > bb_basis
short_signal = (squeeze_fired or squeeze_off) and ta.crossunder(mom, 0) and vol_surge and close < bb_basis

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_signal and strategy.position_size == 0
    long_sl := bb_basis
    risk = close - long_sl
    long_tp := close + (risk * tp_rr)
    strategy.entry("Squeeze Long", strategy.long, comment="MI-007 Squeeze Long")
    strategy.exit("Exit Squeeze Long", "Squeeze Long", stop=long_sl, limit=long_tp)

if short_signal and strategy.position_size == 0
    short_sl := bb_basis
    risk = short_sl - close
    short_tp := close - (risk * tp_rr)
    strategy.entry("Squeeze Short", strategy.short, comment="MI-007 Squeeze Short")
    strategy.exit("Exit Squeeze Short", "Squeeze Short", stop=short_sl, limit=short_tp)

plotshape(squeeze_fired and mom > 0, title="Squeeze Fired Long", location=location.belowbar, color=color.teal, style=shape.labelup, text="SQUEEZE ↑")
plotshape(squeeze_fired and mom < 0, title="Squeeze Fired Short", location=location.abovebar, color=color.orange, style=shape.labeldown, text="SQUEEZE ↓")
