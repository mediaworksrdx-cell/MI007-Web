//@version=5
strategy("MI-007 Institutional AMD (Accumulation-Manipulation-Distribution)", overlay=true, margin_long=100, margin_short=100, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ═══════════════════════════════════════════════════════════════════════════════
// MI-007 INSTITUTIONAL AMD (ACCUMULATION -> MANIPULATION -> DISTRIBUTION)
// System: Market Intelligence MI-007 Proprietary Quantitative Model
// Rules:
// - Accumulation: Tight range consolidation (Asian / pre-market session)
// - Manipulation: Judas swing false breakout / stop-hunt beyond range boundaries
// - Distribution: Impulsive expansion candle driving into higher timeframe targets
// ═══════════════════════════════════════════════════════════════════════════════

range_len = input.int(24, "Accumulation Range Length (Bars)")
tp_rr     = input.float(3.5, "Distribution Target R:R")

range_high = ta.highest(high[1], range_len)
range_low  = ta.lowest(low[1], range_len)
range_size = range_high - range_low
atr_val    = ta.atr(14)

is_tight_accumulation = range_size < (atr_val * 3.0)

// Manipulation Judas Swing (false breakout that immediately rejects)
bullish_judas = is_tight_accumulation and (low < range_low) and (close > range_low) and (close > open)
bearish_judas = is_tight_accumulation and (high > range_high) and (close < range_high) and (close < open)

// Distribution entry
long_signal  = bullish_judas and volume > ta.sma(volume, 20) * 1.25
short_signal = bearish_judas and volume > ta.sma(volume, 20) * 1.25

var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if long_signal and strategy.position_size == 0
    long_sl := low * 0.996
    risk = close - long_sl
    long_tp := close + (risk * tp_rr)
    strategy.entry("AMD Long", strategy.long, comment="MI-007 AMD Long")
    strategy.exit("Exit AMD Long", "AMD Long", stop=long_sl, limit=long_tp)

if short_signal and strategy.position_size == 0
    short_sl := high * 1.004
    risk = short_sl - close
    short_tp := close - (risk * tp_rr)
    strategy.entry("AMD Short", strategy.short, comment="MI-007 AMD Short")
    strategy.exit("Exit AMD Short", "AMD Short", stop=short_sl, limit=short_tp)

plot(range_high, "Accumulation High", color=color.new(color.red, 40))
plot(range_low, "Accumulation Low", color=color.new(color.green, 40))
